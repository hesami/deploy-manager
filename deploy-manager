def production_guard(name):


    conn = sqlite3.connect(
        "/opt/deploy-manager/registry/deploy-manager.db"
    )

    cursor = conn.cursor()


    cursor.execute(
        "SELECT is_production,path FROM applications WHERE name=?",
        (name,)
    )


    app = cursor.fetchone()

    conn.close()


    if not app:

        return True


    is_production = app[0]


    if not is_production:

        return True



    print()

    print("WARNING: Production Deployment")
    print("==============================")


    from core.manager import get_running_container_image


    current = get_running_container_image(
        app[1]
    )


    print()

    print(
        "Current Image:",
        current
    )


    print()


    answer = input(
        "Continue deployment? (yes/no): "
    )


    if answer.lower() != "yes":

        print(
            "Deployment cancelled"
        )

        return False


    return True


