def app_restore(name, backup_id):

    path = get_app_path(name)

    if not path:
        print("Application not found")
        return


    app_id = get_app_id(name)


    deployment_id = add_deployment(
        app_id,
        "restore",
        "running",
        message=f"Restore started for {name}"
    )


    emergency = create_project_backup(
        path,
        app_id
    )


    print(
        "Emergency backup:",
        emergency
    )


    backups = get_backups(app_id)

    target = None

    for backup in backups:

        if str(backup[0]) == str(backup_id):

            target = backup[3]
            break


    if not target:

        print("Backup not found")
        return


    result = restore_project_backup(
        path,
        target
    )


    print(
        "Restore:",
        result
    )


    container = get_container_name(name)

    if container:

        print(
            restart_container(container)
        )


        if wait_container_ready(container):

            update_deployment_status(
                deployment_id,
                "success",
                f"Restore completed for {name}"
            )

        else:

            print(
                "Health check failed. Restoring emergency backup..."
            )


            restore_project_backup(
                path,
                emergency
            )


            restart_container(container)


            update_deployment_status(
                deployment_id,
                "failed",
                f"Restore failed. Emergency rollback completed for {name}"
            )








def app_versions_import(name):

    conn = sqlite3.connect(
        "/opt/deploy-manager/registry/deploy-manager.db"
    )

    cursor = conn.cursor()

    cursor.execute(
        "SELECT id,path FROM applications WHERE name=?",
        (name,)
    )

    app = cursor.fetchone()

    conn.close()


    if not app:

        print("Application not found")
        return


    app_id = app[0]
    path = app[1]


    current_image = get_running_container_image(path)


    if not current_image:

        print("No running image found")
        return


    repository, tag = current_image.split(":")


    existing = image_version_exists(
        current_image
    )


    if existing:

        deactivate_image_versions(
            app_id
        )

        activate_image_version(
            existing
        )

        print(
            "Already exists, activated:",
            current_image
        )

        return


    deactivate_image_versions(
        app_id
    )


    add_image_version(
        app_id,
        repository,
        tag,
        current_image,
        "active"
    )


    print(
        "Imported:",
        current_image
    )






def app_version_rollback(name, tag):

    conn = sqlite3.connect(
        "/opt/deploy-manager/registry/deploy-manager.db"
    )

    cursor = conn.cursor()

    cursor.execute(
        "SELECT id,path FROM applications WHERE name=?",
        (name,)
    )

    app = cursor.fetchone()

    conn.close()


    if not app:

        print("Application not found")
        return


    app_id = app[0]
    path = app[1]


    version = get_image_version_by_tag(
        app_id,
        tag
    )


    if not version:

        print("Version not found")
        return


    image = version[1]


    print(
        "Rolling back to:",
        image
    )


    write_image_override(
        path,
        image
    )


    run_command(
        f"cd {path} && docker compose up -d --no-build"
    )


    container = get_container_name(name)


    if container:

        restart_container(
            container
        )


        if wait_container_ready(container):

            set_active_image_version(
                app_id,
                version[0]
            )


            print(
                "Rollback successful"
            )

        else:

            print(
                "Rollback health check failed"
            )



def app_cleanup(name, keep=3):

    conn = sqlite3.connect(
        "/opt/deploy-manager/registry/deploy-manager.db"
    )

    cursor = conn.cursor()

    cursor.execute(
        "SELECT id FROM applications WHERE name=?",
        (name,)
    )

    app = cursor.fetchone()

    conn.close()


    if not app:

        print("Application not found")
        return


    versions = get_cleanup_versions(
        app[0],
        keep
    )


    if not versions:

        print("Nothing to cleanup")
        return


    print("Removing images:")


    for version in versions:

        print(
            version[1]
        )


    results = cleanup_images(
        versions
    )


    print()


    for index, result in enumerate(results):

        version_id = versions[index][0]

        print(
            result[0],
            "->",
            result[2]
        )


        if result[1]:

            delete_image_version(
                version_id
            )







