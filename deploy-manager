def app_history(name):

    conn = sqlite3.connect(
        "/opt/deploy-manager/registry/deploy-manager.db"
    )

    cursor = conn.cursor()


    cursor.execute(
        """
        SELECT id
        FROM applications
        WHERE name=?
        """,
        (name,)
    )


    app = cursor.fetchone()


    if not app:

        print("Application not found")
        return


    deployments = get_deployments(
        app[0]
    )


    print("""
Deployment History
==================
""")


    print(
        f"{'DATE':20} {'ACTION':12} {'STATUS':10} {'IMAGE'}"
    )

    print(
        "-" * 90
    )


    for item in deployments:

        created = item[5][:16].replace(
            "T",
            " "
        )

        print(
            f"{created:20} {item[2]:12} {item[3]:10} {item[7] or 'N/A'}"
        )


    conn.close()


def main():


    if len(sys.argv) < 2:

        print("""
Deploy Manager

Commands:

 server-info
 docker-info
 scan
 registry-init
 registry-status
 inspect-app <name>
 import
 list
""")

        return


    command = sys.argv[1]


    if command == "server-info":
        server_info()

    elif command == "docker-info":
        docker_info()

    elif command == "registry-init":
        registry_init()

    elif command == "registry-status":
        registry_status()

    elif command == "import":
        do_import()

    elif command == "list":
        list_apps()


    elif command == "pipeline-test":

        if len(sys.argv) < 3:

            print("Application name required")
            return


        app_pipeline_test(
            sys.argv[2]
        )


    elif command == "deploy":

        if len(sys.argv) < 3:

            print("Application name required")
            return


        app_deploy(
            sys.argv[2]
        )


    elif command == "versions":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        app_versions(sys.argv[2])


    elif command == "versions-import":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        app_versions_import(
            sys.argv[2]
        )


    elif command == "rollback-version":

        if len(sys.argv) < 4:
            print("Application name and version required")
            return


        app_version_rollback(
            sys.argv[2],
            sys.argv[3]
        )




    elif command == "cleanup":

        if len(sys.argv) < 3:
            print("Application name required")
            return


        keep = 3


        if "--keep" in sys.argv:

            index = sys.argv.index("--keep")

            if index + 1 < len(sys.argv):

                keep = int(sys.argv[index + 1])


        app_cleanup(
            sys.argv[2],
            keep
        )


    elif command == "restore":

        if len(sys.argv) < 4:
            print("Application name and backup id required")
            return

        app_restore(
            sys.argv[2],
            sys.argv[3]
        )


    elif command == "backups":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        app_backups(sys.argv[2])


    elif command == "backup":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        app_backup(sys.argv[2])


    elif command == "logs":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        app_logs(sys.argv[2])


    elif command == "rebuild":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        app_rebuild(sys.argv[2])


    elif command == "restart":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        app_restart(sys.argv[2])


    elif command == "status":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        app_status(sys.argv[2])

    elif command == "inspect-app":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        inspect(sys.argv[2])


    elif command == "history":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        app_history(sys.argv[2])


    elif command == "rollback":

        if len(sys.argv) < 3:
            print("Application name required")
            return

        path = get_app_path(
            sys.argv[2]
        )

        version = None

        if '--version' in sys.argv:

            index = sys.argv.index('--version')

            if index + 1 < len(sys.argv):
                version = sys.argv[index + 1]

        print(
            rollback_project(path, version)
        )


    else:

        print(
            f"Unknown command: {command}"
        )


if __name__ == "__main__":
    main()
